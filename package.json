{
  "name": "@pinecall/console-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The console's workspace: the page (apps/console) and the core it stands on (packages/core).",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --filter \"./apps/**\" --filter \"./packages/**\" --if-present run build",
    "lint": "pnpm -r --workspace-concurrency=1 --filter \"./apps/**\" --filter \"./packages/**\" run lint",
    "test": "pnpm -r --workspace-concurrency=1 --filter \"./apps/**\" --filter \"./packages/**\" run test",
    "check": "pnpm -r --workspace-concurrency=1 --filter \"./apps/**\" --filter \"./packages/**\" run check"
  }
}
